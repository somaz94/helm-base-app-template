{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "properties": {
        "replicaCount": {
            "type": "integer",
            "minimum": 1
        },
        "version": {
            "type": "string"
        },
        "environment": {
            "type": "string"
        },
        "image": {
            "type": "object",
            "properties": {
                "repository": { "type": "string" },
                "pullPolicy": {
                    "type": "string",
                    "enum": ["Always", "IfNotPresent", "Never"]
                },
                "tag": { "type": "string" }
            },
            "required": ["repository", "pullPolicy"]
        },
        "imagePullSecrets": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" }
                },
                "required": ["name"]
            }
        },
        "nameOverride": { "type": "string" },
        "fullnameOverride": { "type": "string" },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": { "type": "boolean" },
                "automount": { "type": "boolean" },
                "annotations": { "type": "object" },
                "name": { "type": "string" }
            },
            "required": ["create"]
        },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "service": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
                },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
            },
            "required": ["type", "port"]
        },
        "ingress": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "className": { "type": "string" },
                "annotations": { "type": "object" },
                "hosts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "host": { "type": "string" },
                            "paths": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "path": { "type": "string" },
                                        "pathType": {
                                            "type": "string",
                                            "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                                        },
                                        "serviceName": { "type": "string" }
                                    },
                                    "required": ["path", "pathType"]
                                }
                            }
                        },
                        "required": ["host", "paths"]
                    }
                },
                "tls": { "type": "array" }
            }
        },
        "ingressReview": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "className": { "type": "string" },
                "annotations": { "type": "object" },
                "hosts": { "type": "array" }
            }
        },
        "ingressHealth": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "className": { "type": "string" },
                "annotations": { "type": "object" },
                "hosts": { "type": "array" }
            }
        },
        "ingressApiDocs": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "className": { "type": "string" },
                "annotations": { "type": "object" },
                "hosts": { "type": "array" }
            }
        },
        "startupProbe": { "type": "object" },
        "livenessProbe": { "type": "object" },
        "readinessProbe": { "type": "object" },
        "resources": { "type": "object" },
        "strategy": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "config": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": ["RollingUpdate", "Recreate"]
                        },
                        "rollingUpdate": {
                            "type": "object",
                            "properties": {
                                "maxSurge": { "type": ["integer", "string"] },
                                "maxUnavailable": { "type": ["integer", "string"] }
                            }
                        }
                    }
                }
            }
        },
        "autoscaling": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "minReplicas": { "type": "integer", "minimum": 1 },
                "maxReplicas": { "type": "integer", "minimum": 1 },
                "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
                "targetMemoryUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
            }
        },
        "rollout": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "blueGreen": {
                    "type": "object",
                    "properties": {
                        "scaleDownDelaySeconds": { "type": "integer", "minimum": 0 },
                        "autoPromotionEnabled": { "type": "boolean" },
                        "previewReplicaCount": { "type": ["integer", "null"], "minimum": 1 }
                    }
                },
                "analysis": {
                    "type": "object",
                    "properties": {
                        "prePromotion": {
                            "type": "object",
                            "properties": {
                                "templates": { "type": "array", "items": { "type": "object" } },
                                "args": { "type": "array", "items": { "type": "object" } }
                            }
                        },
                        "postPromotion": {
                            "type": "object",
                            "properties": {
                                "templates": { "type": "array", "items": { "type": "object" } },
                                "args": { "type": "array", "items": { "type": "object" } }
                            }
                        }
                    }
                }
            }
        },
        "analysisTemplates": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "spec": { "type": "object" }
                },
                "required": ["name", "spec"]
            }
        },
        "ingressPreview": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "className": { "type": "string" },
                "annotations": { "type": "object" },
                "hosts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "host": { "type": "string" },
                            "paths": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "path": { "type": "string" },
                                        "pathType": {
                                            "type": "string",
                                            "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                                        }
                                    },
                                    "required": ["path", "pathType"]
                                }
                            }
                        },
                        "required": ["host", "paths"]
                    }
                },
                "tls": { "type": "array" }
            }
        },
        "podDisruptionBudget": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "minAvailable": { "type": ["integer", "string"] },
                "maxUnavailable": { "type": ["integer", "string"] }
            }
        },
        "backendConfig": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "timeoutSec": { "type": "integer" },
                "connectionDraining": { "type": "object" },
                "healthCheck": { "type": "object" },
                "sessionAffinity": { "type": "object" },
                "securityPolicy": { "type": "object" },
                "cdn": { "type": "object" },
                "iap": { "type": "object" },
                "logging": { "type": "object" },
                "customRequestHeaders": { "type": "object" }
            }
        },
        "frontendConfig": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "redirectToHttps": { "type": "object" },
                "sslPolicy": { "type": "string" }
            }
        },
        "httproute": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "annotations": { "type": "object" },
                "parentRefs": { "type": "array" },
                "hostnames": { "type": "array", "items": { "type": "string" } },
                "rules": { "type": "array" },
                "httpsRedirect": {
                    "type": "object",
                    "properties": {
                        "enabled": { "type": "boolean" },
                        "statusCode": { "type": "integer" },
                        "port": { "type": "integer" },
                        "parentRefs": { "type": "array" }
                    }
                }
            }
        },
        "storageClasses": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "provisioner": { "type": "string" },
                    "reclaimPolicy": { "type": "string", "enum": ["Retain", "Delete"] },
                    "volumeBindingMode": { "type": "string", "enum": ["Immediate", "WaitForFirstConsumer"] },
                    "allowVolumeExpansion": { "type": "boolean" },
                    "parameters": { "type": "object" },
                    "annotations": { "type": "object" },
                    "mountOptions": { "type": "array", "items": { "type": "string" } },
                    "allowedTopologies": { "type": "array" }
                },
                "required": ["name", "provisioner"]
            }
        },
        "rbac": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" }
            }
        },
        "nodeSelector": { "type": "object" },
        "tolerations": {
            "type": "array",
            "items": { "type": "object" }
        },
        "affinity": { "type": "object" },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
        "envConfig": { "type": "object" },
        "configs": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "items": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string" },
                            "datas": { "type": "object" }
                        },
                        "required": ["name", "datas"]
                    }
                }
            }
        },
        "externalSecrets": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "refreshInterval": { "type": "string" },
                "secretStoreRef": {
                    "type": "object",
                    "properties": {
                        "name": { "type": "string" },
                        "kind": { "type": "string" }
                    },
                    "required": ["name"]
                },
                "dataFrom": {
                    "type": "array",
                    "items": { "type": "object" }
                }
            }
        },
        "volumes": {
            "type": "array",
            "items": { "type": "object" }
        },
        "volumeMounts": {
            "type": "array",
            "items": { "type": "object" }
        },
        "storage": {
            "type": "object",
            "properties": {
                "persistentVolumes": {
                    "type": "object",
                    "properties": {
                        "enabled": { "type": "boolean" },
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "source": { "type": "string", "enum": ["csi", "nfs"] },
                                    "driver": { "type": "string" },
                                    "volumeHandle": { "type": "string" },
                                    "volumeAttributes": { "type": "object" },
                                    "nodeStageSecretRef": { "type": "object" },
                                    "nodePublishSecretRef": { "type": "object" },
                                    "fsType": { "type": "string" },
                                    "readOnly": { "type": "boolean" },
                                    "mountOptions": { "type": "array", "items": { "type": "string" } },
                                    "server": { "type": "string" },
                                    "path": { "type": "string" },
                                    "storage": { "type": "string" },
                                    "volumeMode": { "type": "string" },
                                    "accessModes": {
                                        "type": "array",
                                        "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"] }
                                    },
                                    "reclaimPolicy": {
                                        "type": "string",
                                        "enum": ["Retain", "Delete", "Recycle"]
                                    },
                                    "storageClassName": { "type": "string" }
                                },
                                "required": ["name", "storage", "accessModes", "storageClassName"],
                                "anyOf": [
                                    { "required": ["volumeHandle"] },
                                    { "required": ["server", "path"] }
                                ]
                            }
                        }
                    }
                },
                "persistentVolumeClaims": {
                    "type": "object",
                    "properties": {
                        "enabled": { "type": "boolean" },
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "accessModes": {
                                        "type": "array",
                                        "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany"] }
                                    },
                                    "storageClassName": { "type": "string" },
                                    "storage": { "type": "string" },
                                    "mountPath": { "type": "string" },
                                    "readOnly": { "type": "boolean" },
                                    "selector": {
                                        "type": "object",
                                        "properties": {
                                            "volumeName": { "type": "string" }
                                        }
                                    }
                                },
                                "required": ["name", "accessModes", "storageClassName", "storage", "mountPath"]
                            }
                        }
                    }
                }
            }
        }
    },
    "required": ["replicaCount", "image", "service"]
}
